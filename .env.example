# ===== 数据库（PostgreSQL）=====
# 本地开发默认连接，请按实际环境修改
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_tool?schema=public"

# ===== 应用密钥（用于 JWT 签名，务必修改为随机长字符串）=====
# 生成方式: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-random-48-byte-hex-string"

# ===== 运行时 =====
NODE_ENV="development"
# 部署后使用 https://你的域名
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===== 初始管理员账号（首次启动 seed 时创建）=====
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Admin@123456"
SEED_ADMIN_NAME="系统管理员"

# ===== 周报人员清单（按工号或拼音首字母缩写，逗号分隔）=====
WEEKLY_STAFF="zs,lw,wq,ly,zc,yh,xy,hj,xm,zl,wg,cz,qy,ww,ty,dy,czh,lm,zy,ph,yf,zhx,jr,sw,hy,cl,tf,xf,qh,wk,mt"
